# Copy this file to .env and fill in your own values.
# NEVER commit .env to GitHub - it is already in .gitignore.

# Day 1: from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Day 2: from your trainer (or platform.openai.com)
OPENAI_API_KEY=
# Optional: change the model (default gpt-6-luna)
OPENAI_MODEL=gpt-6-luna

# Day 2: from Supabase > Project Settings > API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Deploy day: any random string, keeps strangers from calling your webhook
WEBHOOK_SECRET=
